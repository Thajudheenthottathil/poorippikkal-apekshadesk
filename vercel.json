{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/google:file.html",
      "destination": "/api/google-verify?file=:file"
    },
    {
      "source": "/api/:path*",
      "destination": "https://ais-pre-63gugiqjyeaupazotrmbsu-535705716580.europe-west2.run.app/api/:path*"
    },
    {
      "source": "/((?!api/|assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}


