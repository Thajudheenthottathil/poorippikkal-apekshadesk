{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|icons/|google[a-zA-Z0-9_-]+\\.html|robots\\.txt|sitemap\\.xml|llms\\.txt|manifest\\.webmanifest|sw\\.js|workbox-.*).*)",
      "destination": "/index.html"
    }
  ]
}
